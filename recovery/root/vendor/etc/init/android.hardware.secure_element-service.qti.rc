# android.hardware.secure_element-service.qti — QCOM eSE bridge
#
# FIX: Xóa "on init → start vendor.secure_element"
# Lý do: trên myron, eSE (Thales JavaCard) được access trực tiếp
# qua se_omapi binary (đã có trong ODM). vendor.secure_element là
# QCOM's proprietary eSE bridge và crash với "Unknown eSE HW".
# se_omapi tự quản lý kết nối eSE → không cần service này trong recovery.
#
# Service vẫn được khai báo nhưng KHÔNG tự start (disabled + lazy).
service vendor.secure_element /vendor/bin/hw/android.hardware.secure_element-service.qti
    class hal
    user root
    group nfc root
    disabled
    interface aidl android.hardware.secure_element.ISecureElement/eSE1
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/odm/lib64:/system/lib64:/sbin
    seclabel u:r:recovery:s0
