# Confirmed from ROM: service name = vendor.secure_element, class early_hal (auto-start)
service vendor.secure_element /vendor/bin/hw/android.hardware.secure_element-service.qti
    class early_hal
    user root
    group root nfc
    interface aidl android.hardware.secure_element.ISecureElement/eSE1
    setenv LD_LIBRARY_PATH /odm/lib64:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    seclabel u:r:recovery:s0
