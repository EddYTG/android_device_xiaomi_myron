<!--
    Vendor VINTF manifest — myron (POCO F8 Ultra / SM8850 sun)
    Confirmed from: adb shell cat /vendor/etc/vintf/manifest.xml (stock ROM)
    + adb shell cat /vendor/etc/vintf/manifest/android.hardware.security.keymint-service-qti.xml
    
    NOTE: keymint HAL declared separately in manifest/android.hardware.security.keymint-service-qti.xml
    Stock manifest.xml only has: gatekeeper, secure_element, NFC, NXP NFC
    Tree adds keymint entries here for OFox VINTF merge compatibility.
    
    REMOVED: HIDL android.hardware.keymaster@4.1 stub — no binary exists,
    causes VINTF verifier to flag missing service → servicemanager reject → decrypt fail.
-->
<manifest version="9.0" type="device">
    <hal format="aidl">
        <n>android.hardware.security.keymint</n>
        <version>3</version>
        <fqname>IKeyMintDevice/default</fqname>
    </hal>
    <hal format="aidl">
        <n>android.hardware.security.keymint</n>
        <version>3</version>
        <fqname>IRemotelyProvisionedComponent/default</fqname>
    </hal>
    <hal format="aidl">
        <n>android.hardware.gatekeeper</n>
        <fqname>IGatekeeper/default</fqname>
    </hal>
    <hal format="aidl">
        <n>android.hardware.secure_element</n>
        <fqname>ISecureElement/eSE1</fqname>
    </hal>
</manifest>
