on boot

# For starting recovery on 5.0 and newer
service recovery /system/bin/recovery
    socket recovery stream 422 system system
    # Disable MTE + libpixelflinger JIT — kernel 6.12 SM8850 MTE causes
    # SIGSEGV SEGV_ACCERR khi JIT scanline shader execute với tag mismatch.
    # PIXELFLINGER_NO_JIT=1  → dùng software renderer, không JIT
    # LIBC_DISABLE_MTE=1     → linker disable MTE trước khi process start
    # MALLOC_OPTIONS=""      → tắt tagged malloc
    setenv MALLOC_OPTIONS ""
    setenv LIBC_DISABLE_MTE 1
    setenv PIXELFLINGER_NO_JIT 1
    memtag off
    seclabel u:r:recovery:s0
    user root
