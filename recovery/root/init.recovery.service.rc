on boot

# For starting recovery on 5.0 and newer
service recovery /system/bin/recovery
    socket recovery stream 422 system system
    # Disable MTE for recovery process — kernel 6.12 MTE causes
    # libpixelflinger JIT SIGSEGV (SEGV_ACCERR tag mismatch)
    setenv MALLOC_OPTIONS ""
    memtag off
    seclabel u:r:recovery:s0
    user root
