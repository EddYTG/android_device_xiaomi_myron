#
# myron (POCO F8 Ultra / SM8850 canoe) — init.recovery.qcom.rc v6
# PATCHED: service names confirmed from ROM dump
#   vendor.keymint       → QTI onekeymint (auto-start on init)
#   vendor.weaver_nxp    → NXP Weaver (auto-start class hal)
#   vendor.keymint-strongbox → NXP Strongbox (auto-start class early_hal)
#   vendor.secure_element → QTI SE HAL (auto-start class early_hal)
#   OMAPI                → com.android.se Java app (no native binary)

import /init.recovery.wifi.rc

on init
    # QTI KeyMint auto-starts via its own RC (on init trigger)
    setprop prepdecrypt.setpatch true

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0771 root system
    install_keyring

on post-fs
    # /persist symlink → /mnt/vendor/persist
    start odm.persist-alias-setup
    # Detect SKU → copy variant files → setprop twrp.variant.files_copied=1
    start odm.variant-script

on boot
    setprop sys.usb.config adb

on property:twrp.modules.loaded=true
    # Mount firmware partition (eSE Thales/NXP JavaCard firmware TAs)
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # Boot ADSP
    wait /sys/kernel/boot_adsp/ssr
    write /sys/kernel/boot_adsp/ssr 1
    # Battery
    wait /sys/class/power_supply/battery 5
    start vendor.health-default
    # Firmware symlink (initial — trước khi TA staging)
    umount /vendor
    symlink /firmware /vendor/firmware_mnt

on property:twrp.variant.files_copied=1
    # Stage firmware TAs: sleep 18s → setprop twrp.myron.fix22zr.ready=1
    start odm.secure-element-ta-setup
    # Vibrator + touch: độc lập, không ảnh hưởng decrypt
    start odm.vibratorfeature-service
    start odm.touch_report

on property:twrp.myron.fix22zr.ready=1
    # TAs staged → restart SE chain với firmware đúng
    # Weaver KHÔNG restart — class hal tự running, không cần
    stop vendor.secure_element
    stop vendor.keymint-strongbox
    # Redirect firmware_mnt → staging dir
    rm /vendor/firmware_mnt
    symlink /tmp/secure_element_fwroot /vendor/firmware_mnt
    # Restart theo đúng thứ tự: SE trước → strongbox sau
    start vendor.secure_element
    start vendor.keymint-strongbox
    start odm.secure-element-followup

on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start odm.decrypt-gate

on property:crypto.ready=1
    start odm.umountvendor

# ─── Services ────────────────────────────────────────────────────────────────

service odm.persist-alias-setup /system/bin/persist-alias-setup.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.variant-script /odm/bin/variant-script.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.decrypt-gate /system/bin/decrypt-gate.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.secure-element-ta-setup /system/bin/secure-element-ta-setup.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0

service odm.secure-element-followup /system/bin/secure-element-followup.sh
    disabled
    oneshot
    user root
    group root
    seclabel u:r:recovery:s0
