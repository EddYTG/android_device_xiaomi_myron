# Xiaomi myron (sm8850_thales) — system.prop
# Extracted/confirmed from recovery.img prop.default

# ADB
ro.adb.secure=0

# Dynamic partitions
ro.boot.dynamic_partitions=true

# Gatekeeper — confirmed: vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.disable_spu=true
vendor.gatekeeper.is_security_level_spu=0

# USB — confirmed từ init.recovery.usb.rc
vendor.usb.configfs=1
vendor.usb.rps_mask=0
vendor.usb.uvc.function.init=1

# USB controller — a600000.dwc3 (Qualcomm standard)
sys.usb.controller=a600000.dwc3
sys.usb.rndis.func.name=gsi

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.volume.metadata.method=dm-default-key

# Display
ro.minui.pixel_format=RGBX_8888
ro.surface_flinger.game_default_frame_rate_override=60

# Virtual A/B — confirmed: ro.virtual_ab.enabled=true
ro.virtual_ab.enabled=true
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.userspace.snapshots.enabled=true
ro.virtual_ab.batch_writes=true
ro.virtual_ab.io_uring.enabled=true
ro.virtual_ab.compression.xor.enabled=true

# Battery
ro.charger.enable_suspend=1

# Vendor
ro.vendor.qti.va_aosp.support=1
ro.board.platform=xiaomi_sm8850
ro.product.board=sun
ro.product.first_api_level=35

# Zygote 64-bit only
ro.zygote=zygote64
dalvik.vm.dex2oat64.enabled=true

# Recovery USB IDs — confirmed từ prop.default
ro.recovery.usb.vid=18D1
ro.recovery.usb.adb.pid=D001
ro.recovery.usb.fastboot.pid=4EE0
