# recovery.fstab — Xiaomi myron (sm8850_thales)
# FIX v2: bỏ slotselect cho logical (A-only), giữ đúng wrappedkey_v0

# Logical partitions (bỏ slotselect — A-only device)
system          /system         erofs   ro                  wait,avb=vbmeta_system,logical,first_stage_mount
system          /system         ext4    ro,barrier=1        wait,avb=vbmeta_system,logical,first_stage_mount
system_ext      /system_ext     erofs   ro                  wait,avb=vbmeta_system,logical,first_stage_mount
system_ext      /system_ext     ext4    ro,barrier=1        wait,avb=vbmeta_system,logical,first_stage_mount
product         /product        erofs   ro                  wait,avb=vbmeta_system,logical,first_stage_mount
product         /product        ext4    ro,barrier=1        wait,avb=vbmeta_system,logical,first_stage_mount
vendor          /vendor         erofs   ro                  wait,avb=vbmeta,logical,first_stage_mount
vendor          /vendor         ext4    ro,barrier=1        wait,avb=vbmeta,logical,first_stage_mount
vendor_dlkm     /vendor_dlkm    erofs   ro                  wait,avb=vbmeta,logical,first_stage_mount
vendor_dlkm     /vendor_dlkm    ext4    ro,barrier=1        wait,avb=vbmeta,logical,first_stage_mount
system_dlkm     /system_dlkm    erofs   ro                  wait,avb=vbmeta,logical,first_stage_mount
system_dlkm     /system_dlkm    ext4    ro,barrier=1        wait,avb=vbmeta,logical,first_stage_mount
odm             /odm            erofs   ro                  wait,avb=vbmeta,logical,first_stage_mount
odm             /odm            ext4    ro,barrier=1        wait,avb=vbmeta,logical,first_stage_mount
mi_ext          /mi_ext         erofs   ro                  wait,avb=vbmeta,logical,first_stage_mount,nofail
mi_ext          /mi_ext         ext4    ro,barrier=1        wait,avb=vbmeta,logical,first_stage_mount,nofail

# Metadata (wrappedkey bắt buộc cho FBE device này)
/dev/block/bootdevice/by-name/metadata  /metadata   f2fs    noatime,nosuid,nodev,discard    wait,check,formattable,wrappedkey,first_stage_mount

# Userdata FBE v2 — copy chính xác từ stock fstab
/dev/block/bootdevice/by-name/userdata  /data   f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt,gc_merge    latemount,wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs

# Physical
/dev/block/bootdevice/by-name/misc      /misc       emmc    defaults                        defaults
/dev/block/bootdevice/by-name/persist   /persist    ext4    noatime,nosuid,nodev,barrier=1  wait
/dev/block/bootdevice/by-name/rescue    /cache      ext4    noatime,nosuid,nodev,barrier=1  wait

# Boot
/dev/block/bootdevice/by-name/boot          /boot           emmc    defaults    recoveryonly
/dev/block/bootdevice/by-name/recovery      /recovery       emmc    defaults    recoveryonly
/dev/block/bootdevice/by-name/init_boot     /init_boot      emmc    defaults    recoveryonly
/dev/block/bootdevice/by-name/vendor_boot   /vendor_boot    emmc    defaults    recoveryonly
/dev/block/bootdevice/by-name/dtbo          /dtbo           emmc    defaults    recoveryonly

# AVB
/dev/block/bootdevice/by-name/vbmeta        /vbmeta         emmc    defaults    defaults
/dev/block/bootdevice/by-name/vbmeta_system /vbmeta_system  emmc    defaults    defaults

# USB OTG
/devices/platform/soc/a600000.ssusb/*.dwc3/xhci-hcd.*.auto*   /usbotg   auto   nosuid,nodev   wait,voldmanaged=usbotg:auto
